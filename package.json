{
  "name": "pi-learn",
  "version": "0.1.0",
  "description": "Learn any subject with pi: a persistent knowledge graph, frozen exit criteria, and visible progress.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "learning",
    "tutor"
  ],
  "pi": {
    "extensions": [
      "./extensions/learn/index.ts",
      "./extensions/questions/index.ts",
      "./extensions/md-log/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "test": "node --test --experimental-strip-types 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit -p ."
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@mermaid-js/mermaid-cli": "^11.17.0",
    "@mozilla/readability": "^0.6.0",
    "@resvg/resvg-js": "^2.6.2",
    "linkedom": "^0.18.13",
    "turndown": "^7.2.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "@types/node": "^26.6.5",
    "@types/turndown": "^5.0.6",
    "typebox": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
